NODE_ENV=development
PORT=6000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/asset_management

REQUEST_BODY_LIMIT=256kb
TRUST_PROXY=false
CORS_ORIGIN=http://localhost:3000,http://localhost:8080
FRONTEND_URL=http://localhost:8080

PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000
PG_STATEMENT_TIMEOUT_MS=10000
PG_SSL_CA_CERT=

JWT_SECRET=replace-with-at-least-16-characters
JWT_REFRESH_SECRET=replace-with-at-least-16-characters
TOKEN_HASH_PEPPER=replace-with-at-least-16-characters
JWT_ISSUER=asset-management-api
JWT_AUDIENCE=asset-management-client
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_DOMAIN=
COOKIE_SECURE=false

RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL=no-reply@example.com
SUPPORT_EMAIL=support@example.com
LOG_OTP_FOR_DEBUG=false

ASSET_IMPORT_MAX_FILE_BYTES=10485760
ASSET_IMPORT_MAX_ROWS=5000
