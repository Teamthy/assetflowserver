<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome</title>
    <!--[if mso]>
    <style type="text/css">
        body, table, td {font-family: Arial, sans-serif !important;}
    </style>
    <![endif]-->
    <style type="text/css">
        body {
            margin: 0;
            padding: 0;
            -webkit-text-size-adjust: 100%;
            -ms-text-size-adjust: 100%;
        }

        table {
            border-collapse: collapse;
            mso-table-lspace: 0pt;
            mso-table-rspace: 0pt;
        }

        img {
            border: 0;
            height: auto;
            line-height: 100%;
            outline: none;
            text-decoration: none;
            -ms-interpolation-mode: bicubic;
        }

        a {
            color: #0066FF;
            text-decoration: none;
        }

        a:hover {
            color: #0052CC;
            text-decoration: underline;
        }

        @media only screen and (max-width: 600px) {
            .email-container {
                width: 100% !important;
            }

            .mobile-padding {
                padding: 12px !important;
            }
        }
    </style>
</head>

<body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; background-color: #ffffff; color: #000000;">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #ffffff;">
        <tr>
            <td align="center" style="padding: 20px 0;">
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" class="email-container" style="max-width: 600px; width: 100%;">
                    <tr>
                        <td class="mobile-padding" style="padding: 16px;">

                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-bottom: 0;">
                                <tr>
                                    <td align="left" style="padding: 0 0 24px 0;">
                                        <img src="" alt="Logo" width="200" height="50" border="0" style="display: block; max-width: 200px; height: auto; border: 0;" />
                                    </td>
                                </tr>
                            </table>

                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td style="padding: 0 0 16px 0;">
                                        <hr style="border: none; border-top: 1px solid #EAECF0; margin: 0;" />
                                    </td>
                                </tr>
                            </table>

                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td style="font-size: 18px; font-weight: 700; color: #000000; text-align: left; padding-bottom: 20px; letter-spacing: -0.02em;">
                                        Welcome Onboard
                                    </td>
                                </tr>
                            </table>

                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td style="font-size: 14px; font-weight: 400; color: #000000; text-align: left; padding-bottom: 16px;">
                                        Hi {{firstName}},
                                    </td>
                                </tr>
                            </table>

                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td style="font-size: 14px; font-weight: 400; line-height: 1.5; color: #000000; text-align: left; padding-bottom: 20px;">
                                        Welcome to <strong>{{organizationName}}</strong>. Your account has been created successfully and you can now sign in and start using the platform.
                                    </td>
                                </tr>
                            </table>

                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td style="font-size: 13px; font-weight: 400; line-height: 1.5; color: #000000; text-align: left; padding-bottom: 16px;">
                                        If you did not create this account, please contact support immediately.
                                    </td>
                                </tr>
                            </table>

                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td style="padding: 16px 0;">
                                        <hr style="border: none; border-top: 1px solid #EAECF0; margin: 0;" />
                                    </td>
                                </tr>
                            </table>

                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td style="padding-top: 16px; padding-bottom: 32px;">
                                        <p style="font-size: 13px; font-weight: 400; color: #000000; margin: 0 0 2px 0; text-align: left;">Best Regards,</p>
                                        <p style="font-size: 13px; font-weight: 400; color: #000000; margin: 0; text-align: left;">The Team.</p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>

</html>
