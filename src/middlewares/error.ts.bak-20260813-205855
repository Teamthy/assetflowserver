import { NextFunction, Request, Response } from "express";
import { isAppError, toAppError, ValidationError } from "../utils/error";
import { logger, safeStringify } from "../utils/logger";
import { captureException } from "../config/sentry";

export const errorHandler = (
  err: unknown,
  req: Request,
  res: Response,
  _next: NextFunction
) => {
  const appError = isAppError(err) ? err : toAppError(err);
  const validationErrors =
    appError instanceof ValidationError ? appError.errors : undefined;

  logger.error(
    safeStringify({
      code: appError.code,
      message: appError.message,
      statusCode: appError.statusCode,
      method: req.method,
      path: req.originalUrl,
      validationErrors,
      stack: appError.stack,
    })
  );

  // Send 5xx errors to Sentry with request context
  if (appError.statusCode >= 500) {
    captureException(err, {
      code: appError.code,
      statusCode: appError.statusCode,
      method: req.method,
      path: req.originalUrl,
      userId: req.auth?.userId,
      organizationId: req.auth?.organizationId,
    });
  }

  const message = formatValidationMessage(appError.message, validationErrors);

  return res.status(appError.statusCode).json({
    success: false,
    code: appError.code,
    message,
    ...(validationErrors ? { errors: validationErrors } : {}),
  });
};

const formatValidationMessage = (fallback: string, errors: unknown): string => {
  if (fallback !== "Validation failed") return fallback;
  if (!Array.isArray(errors) || errors.length === 0) return fallback;

  const parts = errors.slice(0, 3).map((issue) => {
    if (!issue || typeof issue !== "object") return "";
    const row = issue as { path?: Array<string | number>; message?: string };
    const path = Array.isArray(row.path)
      ? row.path.filter((part) => part !== undefined && part !== "").join(".")
      : "";
    const text = typeof row.message === "string" ? row.message : "";
    if (path && text) return `${path}: ${text}`;
    return text;
  }).filter(Boolean);

  return parts.length > 0 ? parts.join(" · ") : fallback;
};
